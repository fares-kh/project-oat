# Copy to .env.local and fill in. Never commit real values.
#
# The app builds and type-checks without these; they are read at runtime when a
# route handler runs. Any route needing a missing value returns a 500 naming it.

# --- Public site URL -------------------------------------------------------
# Used to build SumUp redirect and webhook URLs. No trailing slash.
# Production: https://elliesoats.co.uk
# Dev:        https://dev.elliesoats.co.uk
# Local:      http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- SumUp (payments) ------------------------------------------------------
# Use a SANDBOX merchant for anything that is not production.
# https://me.sumup.com/settings/developer?tab=sandboxes
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# --- Supabase (orders) -----------------------------------------------------
# Service role key bypasses row level security: server-side only, never in a
# client component.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ------------------------------------------
RESEND_KEY=

# --- Admin dashboard (/admin) ----------------------------------------------
# Shared password for the orders dashboard. Use a different value per
# environment.
ADMIN_PASSWORD=

# Optional. Allows machine access to GET /api/admin/orders via
# "Authorization: Bearer <value>".
ADMIN_API_SECRET=
